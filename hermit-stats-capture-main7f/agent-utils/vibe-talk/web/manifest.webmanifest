{
  "id": "/voice",
  "name": "vibe-talk",
  "short_name": "vibe-talk",
  "description": "Read, hear, and reply to your chat messages.",
  "start_url": "/voice",
  "scope": "/",
  "display_override": ["standalone"],
  "display": "browser",
  "background_color": "#152638",
  "icons": [
    {
      "src": "/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
