+def in_flight_run_handles(report: Mapping[str, object]) -> list[Mapping[str, object]]:
+    """Return ci-hub records whose validation is launching or running."""
+
+    selected: list[Mapping[str, object]] = []
+    handles = report.get("run_handles")
+    if not isinstance(handles, list):
+        raise ObservationUnavailable("exact validate-status omitted run_handles")
+    for handle in handles:
+        if not isinstance(handle, dict):
+            raise ObservationUnavailable("exact validate-status returned a malformed run handle")
+        if handle.get("state") not in {"launching", "running"}:
+            continue
+        if handle.get("admission") == "refused":
+            continue
+        required = ("unit", "sha", "started_at", "slot", "log_file")
+        if any(not isinstance(handle.get(field), str) or not handle[field] for field in required):
+            raise ObservationUnavailable(
+                "an in-flight run handle omitted its unit, SHA, start time, slot, or log path"
+            )
+        if not isinstance(handle.get("process_verified"), bool):
+            raise ObservationUnavailable(
+                "an in-flight run handle omitted whether its process identity was verified"
+            )
+        selected.append(handle)
+    return selected
+
+
+def in_flight_run_text(handles: Sequence[Mapping[str, object]]) -> str:
+    return "; ".join(
+        "unit={unit} state={state} head={sha} slot={slot} log={log_file} "
+        "started={started_at} process_verified={process_verified}".format(**handle)
+        for handle in handles
+    )
+
+
+def exact_status_twice(
+    settings: Settings, target: str, deadline: float, run: Runner
+) -> tuple[int, int, dict[str, object], list[Mapping[str, object]]]:
+    """Read twice before claiming no exact-target validation is in flight."""
+
+    first = exact_record_count(settings, target, remaining(deadline, 25.0), run)
+    if first[0] or first[1]:
+        return (*first, in_flight_run_handles(first[2]))
+    second = exact_record_count(settings, target, remaining(deadline, 25.0), run)
+    handles = in_flight_run_handles(second[2])
+    return second[0], max(second[1], len(handles)), second[2], handles
+
+
