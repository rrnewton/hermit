+                    resource_request(guest, rsrc).await,
+                    ResumeStatus::Signaled(_)
+                ) {
+                    return Err(Errno::EINTR.into());
+                }
+                continue;
+            };
+            let request = Self::sleep_request_abs(guest, deadline).await;
+            if matches!(
+                resource_request(guest, request).await,
+                ResumeStatus::Signaled(_)
+            ) {
