#!/bin/bash
# Stage the host inputs that the RE modes (shim/modes/hybrid, shim/modes/remote) pass to
# remote actions, because RE workers do not have them:
#   shim/rust-sysroot                     hermit's pinned rust toolchain (the sysroot
#                                         rustup resolves from rust-toolchain.toml)
#   shim/third-party/libunwind/staged     libunwind-devel's link inputs (libunwind 1.8 on
#                                         CentOS 9), linked by unwind-sys
# Idempotent; reflinks when it can. Both paths are gitignored.
set -euo pipefail
root=$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)
src=$(cd "$root" && rustc --print sysroot)
want=$(cd "$root" && rustc --version)
dst=$root/shim/rust-sysroot
if [[ -f $dst/.version && $(cat "$dst/.version") == "$want" ]]; then
    echo "$dst: $want (up to date)"
else
    rm -rf "${dst:?}"
    cp -a --reflink=auto "$src" "$dst"
    # Documentation and std sources are never action inputs.
    rm -rf "${dst:?}/share/doc" "${dst:?}/lib/rustlib/src" "${dst:?}/lib/rustlib/rustc-src"
    echo "$want" >"$dst/.version"
    echo "$dst: $want"
fi

lu=$root/shim/third-party/libunwind/staged
mkdir -p "$lu"
for f in libunwind-ptrace.a libunwind-generic.so libunwind-x86_64.so libunwind-x86_64.so.8 libunwind.so libunwind.so.8; do
    [[ -e /usr/lib64/$f ]] || { echo "missing /usr/lib64/$f: install libunwind-devel" >&2; exit 1; }
    cmp -s "/usr/lib64/$f" "$lu/$f" || cp -L "/usr/lib64/$f" "$lu/$f"
done
echo "$lu: $(rpm -q --qf '%{NAME}-%{VERSION}-%{RELEASE}' libunwind-devel 2>/dev/null || echo libunwind)"
