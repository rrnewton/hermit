load("@fbcode_macros//build_defs:export_files.bzl", "buck_export_file")
load("@fbcode_macros//build_defs:native_rules.bzl", "buck_filegroup")
load("@fbsource//tools/build_defs:rust_library.bzl", "rust_library")

oncall("hermit")

# Hermit's ptrace recording tool and the root of its Detcore instantiation,
# compiled apart from the hermit library so it builds in parallel.
rust_library(
    name = "hermit-record",
    srcs = glob(["src/**/*.rs"]),
    autocargo = {"cargo_toml_dir": "."},
    named_deps = {"reverie": "//hermetic_infra/reverie:reverie"},
    # The dispatch agreement test reads both tools' dispatch
    # sources as Cargo's CARGO_MANIFEST_DIR lays them out; stage
    # them in that layout and point the variable at it, as
    # libhermit's test fixtures do (6805 Astra B6).
    resources = [":dispatch-agreement-sources"],
    rustc_flags = [
        "--env-set=CARGO_MANIFEST_DIR=$(location :dispatch-agreement-sources)/hermit-record",
    ],
    # hermit/detcore virtualizes the x86 cpuid instruction; x86-64 only.
    target_compatible_with = ["ovr_config//cpu:x86_64"],
    deps = [
        "fbsource//third-party/rust:bincode",
        "fbsource//third-party/rust:libc",
        "fbsource//third-party/rust:serde",
        "fbsource//third-party/rust:tempfile",
        "fbsource//third-party/rust:tracing",
        "//hermetic_infra/hermit/detcore:detcore",
        "//hermetic_infra/hermit/hermit-record-format:hermit-record-format",
        "//hermetic_infra/reverie:reverie-ptrace",
    ],
)

# This package's Cargo manifest, for the tree check.backend_abstraction runs
# on (//hermetic_infra/hermit:backend-abstraction-repository).
buck_export_file(
    name = "Cargo.toml",
    visibility = ["//hermetic_infra/hermit:"],
)

# The two dispatch sources the subscription/dispatch agreement test
# parses, in the sibling layout Cargo's CARGO_MANIFEST_DIR gives it.
buck_filegroup(
    name = "dispatch-agreement-sources",
    srcs = {
        "hermit-record/src/recorder.rs": "src/recorder.rs",
        "hermit-replay/src/replayer.rs": "//hermetic_infra/hermit/hermit-replay:replayer.rs",
    },
)
