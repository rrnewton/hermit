+fn validate_attempt_is_in_flight(attempt: &ValidateRunAttempt) -> bool {
+    matches!(attempt.state.as_str(), "launching" | "running")
+        && attempt.admission.as_deref() != Some("refused")
+        && attempt.finished_at.is_none()
+        && attempt.result.is_none()
+        && attempt.exit_code.is_none()
+}
+
+fn unverified_attempt_entry(
+    attempt: &ValidateRunAttempt,
+    now: chrono::DateTime<chrono::Utc>,
+) -> ValidateStatusEntry {
+    ValidateStatusEntry {
+        depth: None,
+        run_number: None,
+        verdict: None,
+        result: None,
+        nonqualification_reason: None,
+        in_progress: true,
+        sha: Some(attempt.sha.clone()),
+        branch: None,
+        main_match: None,
+        main_sha: None,
+        git_depth: None,
+        started_at: Some(attempt.started_at.clone()),
+        finished_at: None,
+        elapsed_seconds: elapsed_since(&attempt.started_at, now),
+        tests_executed: None,
+        tests_passed: None,
+        host: local_host(),
+        slot: attempt.slot.clone(),
+        log_file: attempt.log_file.clone(),
+        terminated_by: None,
+        termination_reason: None,
+        no_result_reasons: Vec::new(),
+        summary: format!(
+            "state={} process-verified=false unit={}",
+            attempt.state, attempt.unit
+        ),
+        tree: None,
+        allow_tree_match: false,
+    }
+}
+
+fn include_unverified_attempts(
+    scan: &mut LiveValidateRunScan,
+    now: chrono::DateTime<chrono::Utc>,
+) {
+    let already_listed = scan
+        .entries
+        .iter()
+        .filter_map(|entry| entry.sha.as_deref().zip(entry.started_at.as_deref()))
+        .collect::<BTreeSet<_>>();
+    scan.entries.extend(
+        scan.attempts
+            .iter()
+            .filter(|attempt| {
+                !attempt.process_verified
+                    && validate_attempt_is_in_flight(attempt)
+                    && !already_listed.contains(&(attempt.sha.as_str(), attempt.started_at.as_str()))
+            })
+            .map(|attempt| unverified_attempt_entry(attempt, now)),
+    );
+    scan.entries
+        .sort_by(|left, right| right.started_at.cmp(&left.started_at));
+}
+
+fn fetch_current_validation_main(
+    tool_root: &Path,
+    state_root: &Path,
+    repo: &str,
+) -> Result<String, CiHubError> {
+    let checkout = validation_repo_checkout(state_root, repo);
+    let script = tool_root.join("ci-hub/lib/fetch_ref.py");
+    let output = Command::new("python3")
+        .arg(&script)
+        .arg("--repo")
+        .arg(&checkout)
+        .bounded_output()
+        .map_err(|source| CiHubError::Launch {
+            tool: format!("{} current-main fetch", script.display()),
+            source,
+        })?;
+    if !output.status.success() {
+        return Err(CiHubError::ValidateStatus(format!(
+            "cannot fetch current main for {repo} from {}: {}. Restore GitHub access, then retry `ci-hub validate-status --current-main`",
+            checkout.display(),
+            String::from_utf8_lossy(&output.stderr).trim()
+        )));
+    }
+    let value: serde_json::Value = serde_json::from_slice(&output.stdout).map_err(|error| {
+        CiHubError::ValidateStatus(format!(
+            "current-main fetch returned unreadable JSON: {error}. Retry `ci-hub validate-status --current-main`"
+        ))
+    })?;
+    let sha = value
+        .get("tracking_sha")
+        .and_then(serde_json::Value::as_str)
+        .filter(|sha| is_oid(sha))
+        .ok_or_else(|| CiHubError::ValidateStatus(
+            "current-main fetch omitted a full lowercase tracking_sha; retry `ci-hub validate-status --current-main`".into()
+        ))?;
+    Ok(sha.to_string())
+}
