#!/usr/bin/env bash
# Boxed, globally sequential historical validation that can never mint a
# qualifying landing receipt. The current producer runs with the historical
# checkout as cwd, so its commit/tree evidence describes the target checkout.
set -euo pipefail

usage() {
  cat <<'EOF'
usage: historical-debug-validate --checkout PATH --agent NAME --target SHA [options]

Run one validation DAG profile at an exact historical checkout. The command
enters ci-hub's box-exclusive validate/bench lock, forces scheduler width 1,
and appends a typed NON-QUALIFYING row to the validation ledger.

Required:
  --checkout PATH       clean Hermit worktree at the historical commit
  --agent NAME          lock owner identity
  --target SHA          exact 40-hex checkout HEAD

Options:
  --profile NAME        ci/dag profile (default: portable)
  --dag-file PATH       exact DAG override
  --child-deadline SEC  outer lock deadline (default: 3600)
  -h, --help            print this help
EOF
}

checkout=
agent=
target=
profile=portable
dag_file=
child_deadline=3600

while [[ $# -gt 0 ]]; do
  case "$1" in
    --checkout) checkout=${2:?--checkout requires a path}; shift 2 ;;
    --agent) agent=${2:?--agent requires a name}; shift 2 ;;
    --target) target=${2:?--target requires a SHA}; shift 2 ;;
    --profile) profile=${2:?--profile requires a name}; shift 2 ;;
    --dag-file) dag_file=${2:?--dag-file requires a path}; shift 2 ;;
    --child-deadline) child_deadline=${2:?--child-deadline requires seconds}; shift 2 ;;
    -h|--help) usage; exit 0 ;;
    *) echo "historical-debug-validate: unknown argument: $1" >&2; usage >&2; exit 2 ;;
  esac
done

if [[ -z "$checkout" || -z "$agent" || -z "$target" ]]; then
  echo "historical-debug-validate: --checkout, --agent, and --target are required" >&2
  exit 2
fi
if [[ ! "$target" =~ ^[0-9a-f]{40}$ ]]; then
  echo "historical-debug-validate: --target must be an exact lowercase 40-hex SHA" >&2
  exit 2
fi
if [[ ! "$child_deadline" =~ ^[1-9][0-9]*$ ]]; then
  echo "historical-debug-validate: --child-deadline must be a positive integer" >&2
  exit 2
fi

producer_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)
producer="$producer_root/scripts/validate.rs"
checkout=$(cd "$checkout" && pwd -P) || {
  echo "historical-debug-validate: cannot enter checkout: $checkout" >&2
  exit 2
}

head=$(git -C "$checkout" rev-parse HEAD 2>/dev/null) || {
  echo "historical-debug-validate: checkout is not a Git worktree: $checkout" >&2
  exit 2
}
if [[ "$head" != "$target" ]]; then
  echo "historical-debug-validate: target mismatch: requested $target, checkout HEAD is $head" >&2
  exit 2
fi
if [[ -n "$(git -C "$checkout" status --porcelain)" ]]; then
  echo "historical-debug-validate: checkout must be clean so the row is commit-anchored" >&2
  exit 2
fi

if [[ -n "$dag_file" ]]; then
  if [[ ! -f "$dag_file" ]]; then
    echo "historical-debug-validate: no such DAG file: $dag_file" >&2
    exit 2
  fi
  dag_file=$(cd "$(dirname "$dag_file")" && pwd -P)/$(basename "$dag_file")
fi

parent=${DEV_HERMIT_PARENT:-}
if [[ -z "$parent" || ! -x "$parent/ci-hub/ci-hub" ]]; then
  candidate=$producer_root
  parent=
  for _ in 1 2 3 4; do
    candidate=$(dirname "$candidate")
    if [[ -x "$candidate/ci-hub/ci-hub" ]]; then
      parent=$candidate
      break
    fi
  done
fi
if [[ -z "$parent" || ! -x "$parent/ci-hub/ci-hub" ]]; then
  echo "historical-debug-validate: cannot locate dev-hermit/ci-hub; set DEV_HERMIT_PARENT" >&2
  exit 2
fi
parent=$(cd "$parent" && pwd -P)

ledger=${HERMIT_VALIDATE_LEDGER:-$parent/ignored/validate-run-ledger.jsonl}
child=("$producer" "$profile" --historical-debug -j 1)
if [[ -n "$dag_file" ]]; then
  child+=(--dag-file "$dag_file")
fi

echo "historical-debug-validate: NON-QUALIFYING target=$target profile=$profile" >&2
echo "historical-debug-validate: serialized by ci-hub validate-lock kind=bench" >&2
cd "$checkout"
exec "$parent/ci-hub/ci-hub" validate-lock run \
  --agent "$agent" \
  --kind bench \
  --target "$target" \
  --child-deadline "$child_deadline" \
  -- env \
  CI_HUB_HISTORICAL_DEBUG_PRODUCER=validate-lock-bench-v1 \
  DEV_HERMIT_PARENT="$parent" \
  HERMIT_VALIDATE_LEDGER="$ledger" \
  "${child[@]}"
