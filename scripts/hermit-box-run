#!/usr/bin/env bash
# hermit-box-run — run ONE ad-hoc command inside the dagrun box so it can
# never orphan a setsid/double-fork inner child or leak a burned core / held namespace.
#
# WHY THIS EXISTS
# ---------------
# An ad-hoc `hermit run …` that hits a long-lived / livelock path forms a TWO-process
# tree: an OUTER hermit (session leader, pipe-wait, cpu≈0) plus an INNER supervisor in
# its OWN process group that burns a core / holds a PID namespace and reparents to
# ppid=1. A launcher `kill -- -<PGID>` (what an agent recycle or a tool wall-cap does)
# reaches only the OUTER and ORPHANS the inner — the exact reason ad-hoc runs leak while
# cgroup-scoped dagrun nodes do not.
#
# This wrapper closes that gap WITHOUT new engine code: it emits a ONE-step DAG (with a
# CPU-TIME budget) and drives it through the canonical dagrun, reusing verbatim
#   * boxing ON by default + exit 3 when cgroup-v2/systemd --user scope is unavailable,
#   * the per-step CPU-time budget kill in scheduler._monitor (reads cgroup cpu.stat
#     usage_usec — immune to wall-clock slowdown under load), and
#   * teardown.reap()'s cgroup.kill-first teardown, which SIGKILLs the WHOLE subtree
#     atomically, including setsid / double-fork escapees a process-group kill misses.
# No external kill is ever needed; the box tears the whole tree down on budget or on exit.
#
# CPU-TIME, NOT WALL: the budget is user+system CPU seconds of the whole subtree, read
# from the cgroup. Under contention a merely-slow run still completes once it accrues its
# bounded CPU budget; only a runaway/livelock keeps burning and hits the budget. (A wall
# timeout cannot tell slow from stuck on a saturated core — see
# ai_docs/box-requirements-for-verify-hang-repro_20260803.md.)
#
# USAGE
#   hermit-box-run [--cpu-budget SECS] [--wall SECS] [--mem SIZE] [--cores K]
#                  [--label NAME] [--perf-dir DIR] [--actual-json FILE]
#                  [--allow-cgroup-failure] -- CMD [ARGS...]
#
#   THREE INDEPENDENT CGROUP LIMITS (set any combination; each fires its own clean kill):
#   --cpu-budget SECS  whole-subtree CPU-TIME budget (user+system CPU-s, cgroup cpu.stat);
#                      the run is reaped cgroup.kill-first when it exceeds this. Immune to
#                      machine load — a merely-slow run still finishes; only a runaway hits
#                      it. Default 240 (~4x the ~57 CPU-s known-good `hermit run --strict
#                      --verify` budget B; kill at ~4B). Set per workload.
#   --wall SECS        whole-subtree WALL-CLOCK ceiling (real time). Backstop for a step
#                      that BLOCKS/hangs without burning CPU (a busy loop is caught by
#                      --cpu-budget; a deadlock/sleep is caught here). Reaped cgroup.kill-first
#                      on breach. Unset = the runner default (1800s).
#   --mem SIZE         whole-subtree MEMORY cap -> inner cgroup memory.max. The kernel
#                      OOM-kills the step at its cap (attributed via memory.events oom_kill).
#                      SIZE is a byte count or a suffixed size: 512M, 2G (SI), 1Gi (binary).
#                      Unset = no per-step memory cap (only the outer safe-ci.slice cap).
#   --cores K          constrain the whole subtree to K least-busy free cores (cgroup
#                      cpuset, else sched_setaffinity). K=1 forces sequential execution.
#                      Absent = no core pin.
#   --label NAME       label used for the DAG step tag (default: box).
#   --perf-dir DIR     write per-step + whole-run resource-usage CSVs there.
#   --actual-json FILE (passthrough only) atomically write one versioned JSON record with
#                      observed cgroup CPU usage, limits, termination, and exit. Refuse with
#                      exit 3 and do not replace FILE when final cgroup CPU is unavailable.
#   --allow-cgroup-failure  downgrade to a best-effort UNBOXED run instead of exit 3 when
#                      cgroup boxing cannot be established. NOT recommended (defeats the
#                      whole point); provided for parity with the underlying runner.
#
#   --passthrough      (alias --exec) TRANSPARENT-PASSTHROUGH mode. Stream the child's fd1/fd2
#                      VERBATIM (byte-identical: no `[box.<tag>]` banner/prefix, no scope id on
#                      the consumed streams) and propagate the child's REAL exit status (a
#                      nonzero exit is NOT collapsed to 1). The reaper is KEPT: a transient
#                      systemd --user scope gives a cgroup whose cpu.stat usage_usec is polled
#                      against --cpu-budget and torn down cgroup.kill-first on overrun or exit;
#                      exit 3 (fail-closed) if cgroup boxing is unavailable. Use this whenever
#                      the caller consumes the guest's stdout/stderr (determinism fingerprints,
#                      ASAN/QEMU/verify grep evidence). The DEFAULT (capture) mode drives
#                      dagrun and is a PASS/FAIL harness that swallows guest output.
#   --diag-fd N        (passthrough only) write box diagnostics (scope id, CPU-TIMEOUT notices,
#                      resource CSV) to already-open fd N instead of a temp log. NEVER onto the
#                      consumed fd1/fd2. Use `--diag-fd 2` only when stderr is not consumed.
#   --diag-log FILE    (passthrough only) write box diagnostics to FILE (appended).
#                      Default: a temp file (path announced only on the diag stream, never fd1/fd2).
#
# EXIT CODES
#   default (capture) mode — passthrough from dagrun:
#     0  command succeeded within all limits
#     1  command failed OR was reaped for exceeding a limit — grep the step line to
#        distinguish: "CPU-TIMEOUT" (--cpu-budget), "TIMEOUT"/wall (--wall), or an OOM kill
#        (--mem, memory.max). A reaped runaway/leak is exactly what this prevents.
#     2  bad usage
#     3  cgroup boxing required but unavailable (pass --allow-cgroup-failure to run unboxed)
#   --passthrough mode — the child's REAL exit status is propagated verbatim (0 on success, the
#     real nonzero on failure, 137 for a SIGKILL/cgroup.kill reap; a CPU-TIMEOUT is announced on
#     the diag stream). 2 = bad usage, 3 = cgroup boxing unavailable (unless --allow-cgroup-failure).
set -euo pipefail

SELF="$(readlink -f "${BASH_SOURCE[0]}")"
ROOT="$(cd "$(dirname "$SELF")/.." && pwd)"

cpu_budget=240
wall=""
mem=""
cores=""
label="box"
perf_dir=""
actual_json=""
allow_cgroup_failure=0
passthrough=0
diag_fd=""
diag_log=""

die() { echo "hermit-box-run: $*" >&2; exit 2; }

find_runner() {
  if [ -n "${DAGRUN_BIN:-}" ]; then
    printf '%s\n' "$DAGRUN_BIN"
    return 0
  fi
  local base="$ROOT/agent-utils"
  if [ -x "$base/common/bin/dagrun" ]; then
    printf '%s\n' "$base/common/bin/dagrun"
    return 0
  fi
  if [ -x "$base/py/bin/dagrun" ]; then
    printf '%s\n' "$base/py/bin/dagrun"
    return 0
  fi
  return 1
}

RUNNER="$(find_runner)" || die "dagrun not found; initialize agent-utils or set DAGRUN_BIN"

while [ $# -gt 0 ]; do
  case "$1" in
    --cpu-budget) [ $# -ge 2 ] || die "--cpu-budget needs a value"; cpu_budget="$2"; shift 2 ;;
    --cpu-budget=*) cpu_budget="${1#*=}"; shift ;;
    --wall)       [ $# -ge 2 ] || die "--wall needs a value"; wall="$2"; shift 2 ;;
    --wall=*)     wall="${1#*=}"; shift ;;
    --mem)        [ $# -ge 2 ] || die "--mem needs a value"; mem="$2"; shift 2 ;;
    --mem=*)      mem="${1#*=}"; shift ;;
    --cores)      [ $# -ge 2 ] || die "--cores needs a value"; cores="$2"; shift 2 ;;
    --cores=*)    cores="${1#*=}"; shift ;;
    --label)      [ $# -ge 2 ] || die "--label needs a value"; label="$2"; shift 2 ;;
    --label=*)    label="${1#*=}"; shift ;;
    --perf-dir)   [ $# -ge 2 ] || die "--perf-dir needs a value"; perf_dir="$2"; shift 2 ;;
    --perf-dir=*) perf_dir="${1#*=}"; shift ;;
    --actual-json) [ $# -ge 2 ] || die "--actual-json needs a value"; actual_json="$2"; shift 2 ;;
    --actual-json=*) actual_json="${1#*=}"; shift ;;
    --allow-cgroup-failure) allow_cgroup_failure=1; shift ;;
    --passthrough|--exec) passthrough=1; shift ;;
    --diag-fd)    [ $# -ge 2 ] || die "--diag-fd needs a value"; diag_fd="$2"; shift 2 ;;
    --diag-fd=*)  diag_fd="${1#*=}"; shift ;;
    --diag-log)   [ $# -ge 2 ] || die "--diag-log needs a value"; diag_log="$2"; shift 2 ;;
    --diag-log=*) diag_log="${1#*=}"; shift ;;
    -h|--help)    sed -n '2,/^set -euo pipefail/{/^set -euo pipefail/d;p}' "$SELF"; exit 0 ;;
    --)           shift; break ;;
    -*)           die "unknown option '$1' (put the command after '--')" ;;
    *)            break ;;
  esac
done

[ $# -ge 1 ] || die "no command given (use '-- CMD [ARGS...]')"
case "$cpu_budget" in ''|*[!0-9]*) die "--cpu-budget must be a positive integer (seconds)";; esac
[ "$cpu_budget" -gt 0 ] || die "--cpu-budget must be > 0"
if [ -n "$wall" ]; then
  case "$wall" in ''|*[!0-9]*) die "--wall must be a positive integer (seconds)";; esac
  [ "$wall" -gt 0 ] || die "--wall must be > 0"
fi
if [ -n "$cores" ]; then case "$cores" in ''|*[!0-9]*) die "--cores must be a positive integer";; esac; fi

# --mem: accept a byte count or a suffixed size (512M/2G SI, 1Gi binary) -> bytes. Validate
# up front so a bad size is a usage error (exit 2), not a late runner failure.
mem_bytes=""
if [ -n "$mem" ]; then
  mem_bytes="$(python3 - "$mem" <<'PY'
import re, sys
s = sys.argv[1].strip()
m = re.fullmatch(r'(\d+(?:\.\d+)?)\s*([KMGT]i?B?|B)?', s, re.IGNORECASE)
if not m:
    sys.exit(1)
val = float(m.group(1))
unit = (m.group(2) or "").upper().rstrip("B")
mult = {"": 1, "K": 1000, "M": 1000**2, "G": 1000**3, "T": 1000**4,
        "KI": 1024, "MI": 1024**2, "GI": 1024**3, "TI": 1024**4}
if unit not in mult:
    sys.exit(1)
b = int(val * mult[unit])
if b <= 0:
    sys.exit(1)
print(b)
PY
)" || die "--mem must be a size like 512M, 2G, 1Gi, or a positive byte count"
fi
if [ -n "$diag_fd" ]; then case "$diag_fd" in ''|*[!0-9]*) die "--diag-fd must be a file descriptor number";; esac; fi
if [ "$passthrough" -eq 0 ]; then
  [ -z "$diag_fd" ]  || die "--diag-fd is only valid with --passthrough"
  [ -z "$diag_log" ] || die "--diag-log is only valid with --passthrough"
  [ -z "$actual_json" ] || die "--actual-json is only valid with --passthrough"
fi

# ---------------------------------------------------------------------------
# TRANSPARENT-PASSTHROUGH mode.
#
# The default (capture) path below drives dagrun, a PASS/FAIL harness that
# swallows guest stdout/stderr (only a `[box.<tag>]` tail survives) and injects a
# nondeterministic `safe-ci-<pid>.scope` id into consumed output — fatal for any caller that
# hashes/greps the guest streams. Passthrough instead runs the command in a transient
# systemd --user *scope* whose stdio is INHERITED verbatim, so fd1/fd2 reach the caller
# byte-identically, while the SAME reaper guarantees hold: the scope is a cgroup-v2 subtree
# whose cpu.stat usage_usec (CPU-time, immune to wall slowdown) is polled against the budget
# and torn down cgroup.kill-first (SIGKILLs setsid/double-fork escapees atomically). No
# external kill is used; we only ever signal our OWN scope's cgroup. All box diagnostics go
# to a SEPARATE stream (fd 9 -> --diag-fd / --diag-log / temp log), never onto fd1/fd2.
# ---------------------------------------------------------------------------
passthrough_run() {
  # Open the diagnostic stream on fd 9 (NEVER fd1/fd2).
  if [ -n "$diag_fd" ]; then
    eval "exec 9>&$diag_fd" || die "cannot dup diag fd $diag_fd (is it open?)"
  elif [ -n "$diag_log" ]; then
    exec 9>>"$diag_log" || die "cannot open --diag-log $diag_log"
  else
    diag_log="$(mktemp -t hermit-box-run.XXXXXX.diag.log)"
    exec 9>>"$diag_log"
    # Auto-created diag log: remove on exit so repeated per-run invocations (determinism
    # sweeps etc.) do not accumulate temp files. An explicit --diag-log/--diag-fd is caller-owned.
    HBR_AUTO_DIAG="$diag_log"
    trap 'rm -f "${HBR_AUTO_DIAG:-}"' EXIT
  fi
  diag() { echo "[hermit-box-run] $*" >&9; }

  # Pre-check the box substrate BEFORE launching anything, so an unavailable cgroup is a
  # fail-closed exit 3 with NO child started (unless explicitly downgraded).
  local have_box=1
  [ "$(stat -fc %T /sys/fs/cgroup 2>/dev/null || true)" = "cgroup2fs" ] || have_box=0
  systemctl --user show -p Version >/dev/null 2>&1 || have_box=0
  if [ "$have_box" -eq 0 ]; then
    if [ "$allow_cgroup_failure" -eq 1 ]; then
      diag "WARNING: cgroup boxing unavailable — running UNBOXED (--allow-cgroup-failure). No reaper."
      exec "$@"   # verbatim fd0/1/2, real exit status, but NO reaper.
    fi
    diag "cgroup boxing required but unavailable (cgroup-v2 + systemd --user scope). Refusing (exit 3)."
    echo "hermit-box-run: cgroup boxing unavailable; pass --allow-cgroup-failure to run unboxed (exit 3)" >&2
    exit 3
  fi

  # Optional core pinning: K least-busy CPUs -> systemd AllowedCPUs (cgroup cpuset).
  local allowed_cpus=""
  if [ -n "$cores" ]; then
    allowed_cpus="$(python3 - "$cores" <<'PY'
import sys, time
k = int(sys.argv[1])
def snap():
    d = {}
    for ln in open('/proc/stat'):
        if ln.startswith('cpu') and ln[3:4].isdigit():
            p = ln.split()
            n = int(p[0][3:]); vals = list(map(int, p[1:]))
            d[n] = (sum(vals), vals[3] + (vals[4] if len(vals) > 4 else 0))  # total, idle+iowait
    return d
a = snap(); time.sleep(0.2); b = snap()
busy = {}
for n in a:
    if n in b:
        dt = b[n][0] - a[n][0]; di = b[n][1] - a[n][1]
        busy[n] = (dt - di) / dt if dt else 0.0
picks = sorted(busy, key=lambda n: (busy[n], n))[:max(1, k)]
print(",".join(str(n) for n in sorted(picks)))
PY
)" || allowed_cpus=""
    [ -n "$allowed_cpus" ] && diag "core pin: --cores $cores -> AllowedCPUs=$allowed_cpus"
  fi

  local unit runner_pid="" cgpath=""
  local cgroup_resolved=0 final_usage_observed=0 runner_waited=0
  local payload_completed=0 payload_status_file="" payload_release_file="" hold_dir=""
  local receipt_pid="" completed_cpu_observed=0 completed_cpu_nsec="" maximum_usage=0 accounting_failed=0
  local budget_usec=$(( cpu_budget * 1000000 ))
  local reaped=0 last_usage=0 termination="completed" status=0
  unit="hermit-box-run-$$-$(date +%s%N).scope"
  local -a sr=(systemd-run --user --scope --quiet --unit="$unit"
               --description="hermit-box-run passthrough: $*"
               -p "KillMode=control-group")
  [ -n "$allowed_cpus" ] && sr+=(-p "AllowedCPUs=$allowed_cpus")
  # Memory cap -> cgroup memory.max with swap disabled, so the kernel HARD-OOM-kills the
  # subtree at the cap instead of swapping past it (matches the outer safe-ci.slice policy).
  [ -n "$mem_bytes" ] && sr+=(-p "MemoryMax=$mem_bytes" -p "MemorySwapMax=0")
  diag "scope=$unit cpu-budget=${cpu_budget}s wall=${wall:-none} mem=${mem_bytes:-none} cmd: $*"

  # Preserve BYTE-IDENTICAL passthrough: the boxed CHILD must own the caller's REAL fd1/fd2,
  # while the wrapper shell's OWN output — including bash async job notifications like
  # "Terminated" when the backgrounded scope is signalled — must NOT touch those consumed
  # streams. Save the real stdout/stderr (fd7/fd8), then redirect the wrapper's own fd1/fd2 to
  # the diag stream (fd9). The child is launched with fd1<-7, fd2<-8 (the real streams), and
  # fds 7/8/9 closed so no box bookkeeping fd leaks into the guest.
  exec 7>&1 8>&2
  exec 1>&9 2>&9

  # Arm cleanup BEFORE the first process can enter the scope. An outer runner
  # (ORC included) signals only this direct PID, so a TERM during systemd-run's
  # registration window must be able to find the known unit even though its
  # cgroup path and runner PID may still be only partially initialized.
  _pt_resolve_cgroup() {
    local discovered=""
    if [ -n "$cgpath" ] && [ -r "$cgpath/cgroup.procs" ]; then
      return 0
    fi
    cgpath=""
    discovered="$(systemctl --user show -p ControlGroup --value "$unit" 2>/dev/null || true)"
    if [ -n "$discovered" ] && [ -r "/sys/fs/cgroup$discovered/cgroup.procs" ]; then
      cgpath="/sys/fs/cgroup$discovered"
      return 0
    fi
    return 1
  }
  _pt_read_usage() {
    local observed=""
    [ -n "$cgpath" ] && [ -r "$cgpath/cpu.stat" ] || return 1
    observed="$(awk '$1 == "usage_usec" { print $2; exit }' \
      "$cgpath/cpu.stat" 2>/dev/null)" || return 1
    case "$observed" in
      ''|*[!0-9]*) return 1 ;;
    esac
    printf '%s\n' "$observed"
  }
  _pt_capture_final_usage() {
    local observed=""
    if observed="$(_pt_read_usage)"; then
      [ "$observed" -ge "$maximum_usage" ] || { accounting_failed=1; return 1; }
      last_usage="$observed"
      maximum_usage="$observed"
      final_usage_observed=1
      return 0
    fi
    return 1
  }
  _pt_freeze_and_capture() {
    local attempt
    [ -n "$cgpath" ] && [ -w "$cgpath/cgroup.freeze" ] || return 1
    echo 1 >"$cgpath/cgroup.freeze" 2>/dev/null || return 1
    for attempt in $(seq 1 40); do
      if awk '$1 == "frozen" && $2 == "1" { found=1 } END { exit !found }' \
          "$cgpath/cgroup.events" 2>/dev/null; then
        _pt_capture_final_usage
        return $?
      fi
      sleep 0.01
    done
    return 1
  }
  _pt_kill_scope() {
    local attempts=${1:-20} attempt
    for attempt in $(seq 1 "$attempts"); do
      if _pt_resolve_cgroup && [ -w "$cgpath/cgroup.kill" ]; then
        echo 1 > "$cgpath/cgroup.kill" 2>/dev/null || true
        return 0
      fi
      # The unit name is authority even before ControlGroup becomes readable.
      # Retry briefly because systemd-run may have submitted creation just as
      # the outer process delivered TERM.
      if systemctl --user kill --kill-whom=all --signal=KILL "$unit" \
          >/dev/null 2>&1; then
        return 0
      fi
      [ "$attempt" -ge "$attempts" ] || sleep 0.02
    done
    systemctl --user --no-block stop "$unit" >/dev/null 2>&1 || true
  }
  _pt_start_cpu_reference() {
    # Keep completed unit accounting readable after the held scope is reaped.
    /usr/bin/python3 - "$unit" "$cgpath" "$hold_dir" "$$" <<'CPU_REFERENCE_PY' &
"""Keep one authenticated user unit's actual results alive through scope teardown."""

import ctypes, os, re, time


class BusError(ctypes.Structure):
    _fields_ = [
        ("name", ctypes.c_char_p),
        ("message", ctypes.c_char_p),
        ("need_free", ctypes.c_int),
    ]


class UnitReference:
    def __init__(self, library, unit):
        assert re.fullmatch(r"hermit-box-run-[0-9]+-[0-9]+\.scope", unit)
        self.unit = unit
        self.calls = []
        self.bus = ctypes.c_void_p()
        self.held = False
        self.lib = ctypes.CDLL(library)
        self.lib.sd_bus_open_user.argtypes = [ctypes.POINTER(ctypes.c_void_p)]
        self.lib.sd_bus_open_user.restype = ctypes.c_int
        self.lib.sd_bus_set_method_call_timeout.argtypes = [
            ctypes.c_void_p,
            ctypes.c_uint64,
        ]
        self.lib.sd_bus_set_method_call_timeout.restype = ctypes.c_int
        self.lib.sd_bus_call_method.argtypes = [
            ctypes.c_void_p,
            ctypes.c_char_p,
            ctypes.c_char_p,
            ctypes.c_char_p,
            ctypes.c_char_p,
            ctypes.POINTER(BusError),
            ctypes.POINTER(ctypes.c_void_p),
            ctypes.c_char_p,
        ]
        self.lib.sd_bus_call_method.restype = ctypes.c_int
        self.lib.sd_bus_get_property.argtypes = [
            ctypes.c_void_p,
            ctypes.c_char_p,
            ctypes.c_char_p,
            ctypes.c_char_p,
            ctypes.c_char_p,
            ctypes.POINTER(BusError),
            ctypes.POINTER(ctypes.c_void_p),
            ctypes.c_char_p,
        ]
        self.lib.sd_bus_get_property.restype = ctypes.c_int
        self.lib.sd_bus_message_read.argtypes = [ctypes.c_void_p, ctypes.c_char_p]
        self.lib.sd_bus_message_read.restype = ctypes.c_int
        self.lib.sd_bus_message_unref.argtypes = [ctypes.c_void_p]
        self.lib.sd_bus_message_unref.restype = ctypes.c_void_p
        self.lib.sd_bus_error_free.argtypes = [ctypes.POINTER(BusError)]
        self.lib.sd_bus_error_free.restype = ctypes.POINTER(BusError)
        self.lib.sd_bus_flush_close_unref.argtypes = [ctypes.c_void_p]
        self.lib.sd_bus_flush_close_unref.restype = ctypes.c_void_p
        status = self.lib.sd_bus_open_user(ctypes.byref(self.bus))
        self.calls.append({"function": "sd_bus_open_user", "status": status})
        if status < 0:
            raise OSError(-status, os.strerror(-status))
        status = self.lib.sd_bus_set_method_call_timeout(self.bus, 5_000_000)
        self.calls.append(
            {
                "function": "sd_bus_set_method_call_timeout",
                "microseconds": 5_000_000,
                "status": status,
            }
        )
        if status < 0:
            self.close()
            raise OSError(-status, os.strerror(-status))

    def call_timeout(self, deadline):
        remaining = 5_000_000 if deadline is None else int((deadline - time.monotonic()) * 1_000_000)
        if remaining <= 0:
            raise TimeoutError("completed scope CPU query deadline")
        status = self.lib.sd_bus_set_method_call_timeout(self.bus, remaining)
        if status < 0:
            raise OSError(-status, os.strerror(-status))

    def method(self, member, deadline=None):
        self.call_timeout(deadline)
        assert member in ["RefUnit", "UnrefUnit", "GetUnit"]
        error = BusError()
        reply = ctypes.c_void_p()
        started = time.monotonic()
        try:
            status = self.lib.sd_bus_call_method(
                self.bus,
                b"org.freedesktop.systemd1",
                b"/org/freedesktop/systemd1",
                b"org.freedesktop.systemd1.Manager",
                member.encode(),
                ctypes.byref(error),
                ctypes.byref(reply),
                b"s",
                ctypes.c_char_p(self.unit.encode()),
            )
            row = {
                "function": "sd_bus_call_method",
                "destination": "org.freedesktop.systemd1",
                "path": "/org/freedesktop/systemd1",
                "interface": "org.freedesktop.systemd1.Manager",
                "member": member,
                "signature": "s",
                "arguments": [self.unit],
                "status": status,
                "seconds": time.monotonic() - started,
                "error_name": error.name.decode() if error.name else None,
                "error_message": error.message.decode() if error.message else None,
            }
            self.calls.append(row)
            if status < 0:
                raise OSError(-status, str(row))
            if member == "GetUnit":
                value = ctypes.c_char_p()
                read = self.lib.sd_bus_message_read(reply, b"o", ctypes.byref(value))
                if read <= 0:
                    raise RuntimeError(("GetUnit reply", read))
                return value.value.decode()
        finally:
            if reply:
                self.lib.sd_bus_message_unref(reply)
            self.lib.sd_bus_error_free(ctypes.byref(error))

    def property(self, path, interface, name, deadline):
        self.call_timeout(deadline)
        error = BusError()
        reply = ctypes.c_void_p()
        signature = b"t" if name == "CPUUsageNSec" else b"s"
        started = time.monotonic()
        try:
            status = self.lib.sd_bus_get_property(
                self.bus,
                b"org.freedesktop.systemd1",
                path.encode(),
                interface.encode(),
                name.encode(),
                ctypes.byref(error),
                ctypes.byref(reply),
                signature,
            )
            row = {
                "function": "sd_bus_get_property",
                "path": path,
                "interface": interface,
                "property": name,
                "status": status,
                "seconds": time.monotonic() - started,
                "error_name": error.name.decode() if error.name else None,
                "error_message": error.message.decode() if error.message else None,
            }
            self.calls.append(row)
            if status < 0:
                raise OSError(-status, str(row))
            value = ctypes.c_uint64() if signature == b"t" else ctypes.c_char_p()
            read = self.lib.sd_bus_message_read(reply, signature, ctypes.byref(value))
            if read <= 0:
                raise RuntimeError(("property reply", name, read))
            return value.value if signature == b"t" else value.value.decode()
        finally:
            if reply:
                self.lib.sd_bus_message_unref(reply)
            self.lib.sd_bus_error_free(ctypes.byref(error))

    def properties(self, deadline):
        # Use the already-held connection: a cancellable box must not leave an
        # independently running systemctl query outside its measured scope.
        path = self.method("GetUnit", deadline)
        values = {
            name: self.property(path, "org.freedesktop.systemd1.Unit", name, deadline)
            for name in ["Id", "LoadState", "ActiveState", "SubState"]
        }
        values["CPUUsageNSec"] = self.property(
            path, "org.freedesktop.systemd1.Scope", "CPUUsageNSec", deadline
        )
        return values

    def acquire(self):
        assert self.bus and not self.held
        self.method("RefUnit")
        self.held = True

    def close(self):
        if self.bus:
            try:
                if self.held:
                    self.method("UnrefUnit")
                    self.held = False
            finally:
                self.lib.sd_bus_flush_close_unref(self.bus)
                self.bus = ctypes.c_void_p()
                self.calls.append(
                    {"function": "sd_bus_flush_close_unref", "connection_closed": True}
                )


if __name__ == "__main__":
    from pathlib import Path
    import json, os, signal, sys, time

    unit, group_raw, directory_raw, owner_raw = sys.argv[1:]
    group = Path(group_raw)
    directory = Path(directory_raw)
    owner = int(owner_raw)

    def owner_identity():
        raw = Path("/proc", str(owner), "stat").read_text()
        return int(raw[raw.rindex(")") + 2 :].split()[19])

    original_owner = owner_identity()

    def atomic(name, data):
        temporary = directory / (name + ".tmp")
        temporary.write_text(data)
        temporary.replace(directory / name)

    def interrupted(number, frame):
        raise RuntimeError("CPU reference client interrupted: " + str(number))

    for number in [signal.SIGTERM, signal.SIGINT, signal.SIGHUP]:
        signal.signal(number, interrupted)
    reference = None
    try:
        reference = UnitReference("libsystemd.so.0", unit)
        reference.acquire()
        atomic("cpu.ready", unit + "\n")
        while not (directory / "cpu.finish").exists():
            assert (
                owner_identity() == original_owner
            ), "original box owner disappeared or changed"
            time.sleep(0.02)
        # Completion is requested only after the box kills its own scope and
        # waits for the real launcher. Do not retain a pre-kill snapshot as final.
        deadline = time.monotonic() + 5
        while True:
            values = reference.properties(deadline)
            assert time.monotonic() <= deadline, "completed scope CPU query deadline"
            assert values["Id"] == unit and values["LoadState"] == "loaded", values
            try:
                group.stat()
                events = dict(
                    line.split()
                    for line in (group / "cgroup.events").read_text().splitlines()
                )
                empty = events["populated"] == "0"
            except FileNotFoundError:
                assert (
                    not group.exists()
                ), "cgroup events unavailable while group remains"
                empty = True
            if (
                values["ActiveState"] in ["inactive", "failed"]
                and values["SubState"] in ["dead", "failed"]
                and empty
            ):
                break
            assert time.monotonic() < deadline, (
                "scope has not completed",
                values,
                empty,
            )
            time.sleep(0.01)
        nanoseconds = int(values["CPUUsageNSec"])
        assert 0 <= nanoseconds < 2**64 - 1, values
        minimum_usage = int((directory / "cpu.finish").read_text())
        assert minimum_usage >= 0
        # Compare the raw counter before unit conversion: rounding upward
        # must not conceal even a one-nanosecond regression.
        assert nanoseconds >= minimum_usage * 1000, (nanoseconds, minimum_usage)
        usage = (nanoseconds + 999) // 1000
        # The shell independently refuses a final value below any earlier
        # observed counter, rather than clamping this actual result.
        atomic("cpu.final", str(nanoseconds) + " " + str(usage) + "\n")
        atomic(
            "cpu.readback",
            json.dumps(
                {
                    "unit": unit,
                    "source": "systemd CPUUsageNSec after scope exit",
                    "properties": values,
                    "cgroup_empty": empty,
                    "calls": reference.calls,
                }
            )
            + "\n",
        )
        reference.close()
    except BaseException as error:
        atomic("cpu.error", repr(error) + "\n")
        raise
    finally:
        if reference is not None:
            reference.close()
CPU_REFERENCE_PY
    receipt_pid=$!
    local attempt
    for attempt in $(seq 1 100); do
      [ -f "$hold_dir/cpu.ready" ] && return 0
      kill -0 "$receipt_pid" 2>/dev/null || return 1
      sleep 0.05
    done
    kill -KILL "$receipt_pid" 2>/dev/null || true
    wait "$receipt_pid" 2>/dev/null || true
    return 1
  }
  _pt_teardown() {
    local status=$1
    trap - TERM INT HUP
    # Stop the launcher immediately, then sweep any scope it already submitted.
    # Either variable may still be empty; cleanup is deliberately partial-init-safe.
    if [ -n "$runner_pid" ]; then
      kill -KILL "$runner_pid" 2>/dev/null || true
    fi
    _pt_kill_scope
    if [ -n "$runner_pid" ]; then
      wait "$runner_pid" 2>/dev/null || true
    fi
    if [ -n "$receipt_pid" ]; then
      kill -KILL "$receipt_pid" 2>/dev/null || true
      wait "$receipt_pid" 2>/dev/null || true
    fi
    if [ -n "$hold_dir" ]; then
      rm -f -- "$hold_dir"/cpu.{ready,ready.tmp,finish,finish.tmp,final,final.tmp,readback,readback.tmp,error,error.tmp}
      rm -f -- "$payload_status_file" "$payload_status_file.tmp" \
        "$payload_release_file" 2>/dev/null || true
      rmdir -- "$hold_dir" 2>/dev/null || true
    fi
    exit "$status"
  }
  trap '_pt_teardown 143' TERM
  trap '_pt_teardown 130' INT
  trap '_pt_teardown 129' HUP

  local -a scope_command=("$@")
  if [ -n "$actual_json" ]; then
    hold_dir="$(mktemp -d -t hermit-box-run-hold.XXXXXX)" || {
      echo "hermit-box-run: could not create cgroup receipt hold directory (exit 3)" >&8
      exit 3
    }
    payload_status_file="$hold_dir/status"
    payload_release_file="$hold_dir/release"
    mkfifo -- "$payload_release_file" || {
      echo "hermit-box-run: could not create cgroup receipt hold pipe (exit 3)" >&8
      rmdir -- "$hold_dir" 2>/dev/null || true
      exit 3
    }
    # Keep one inert process in the scope after the payload exits. Otherwise
    # systemd can remove the transient cgroup between wait(2) and the final
    # cpu.stat read, making a completed run lose its receipt. The parent freezes
    # the held cgroup, records its CPU counter, and kills its own scope. The
    # retained unit then supplies the completed total including that teardown.
    scope_command=(bash -c '
      status_file=$1
      release_file=$2
      shift 2
      rc=0
      "$@" || rc=$?
      printf "%s\n" "$rc" >"$status_file.tmp"
      mv -- "$status_file.tmp" "$status_file"
      IFS= read -r _ <"$release_file"
      exit "$rc"
    ' bash "$payload_status_file" "$payload_release_file" "$@")
  fi

  "${sr[@]}" -- "${scope_command[@]}" 1>&7 2>&8 7>&- 8>&- 9>&- &
  runner_pid=$!

  # Resolve the scope's cgroup path (may take a beat to register).
  # `_` because the counter bounds the retry loop and is never read.
  for _ in $(seq 1 40); do
    if _pt_resolve_cgroup && [ -r "$cgpath/cpu.stat" ]; then
      cgroup_resolved=1
      break
    fi
    kill -0 "$runner_pid" 2>/dev/null || break   # child already finished
    sleep 0.05
  done

  # A fast child can exit between systemd-run registering the scope and the
  # first ControlGroup query. Reap it to reserve its status, then make one last
  # query while the transient unit may still be readable. Never infer cgroup
  # availability merely from the child's exit.
  if [ "$cgroup_resolved" -eq 0 ] && ! kill -0 "$runner_pid" 2>/dev/null; then
    wait "$runner_pid" 2>/dev/null || status=$?
    runner_waited=1
    if _pt_resolve_cgroup && [ -r "$cgpath/cpu.stat" ]; then
      cgroup_resolved=1
    fi
  fi

  if [ "$cgroup_resolved" -eq 0 ]; then
    # Could not establish the reaper cgroup. Sweep the named unit even when the
    # direct child has already exited; with fail-closed boxing this invocation
    # is a refusal, never a successful run with invented zero usage.
    diag "ERROR: could not resolve scope cgroup for $unit; sweeping own unit and failing closed."
    _pt_kill_scope
    if [ "$runner_waited" -eq 0 ]; then
      kill -KILL "$runner_pid" 2>/dev/null || true
      wait "$runner_pid" 2>/dev/null || status=$?
      runner_waited=1
    fi
    if [ "$allow_cgroup_failure" -eq 0 ]; then
      echo "hermit-box-run: could not establish reaper cgroup (exit 3)" >&8  # fd8 = real stderr
      status=3
    fi
  else
    diag "cgroup=$cgpath"
    if [ -n "$actual_json" ] && ! _pt_start_cpu_reference; then
      accounting_failed=1
      diag "ERROR: could not retain completed scope CPU accounting."
      _pt_kill_scope
    fi
    # Wall deadline (real-clock backstop for a blocked/hung child that burns no CPU). The
    # memory cap needs no polling: the kernel OOM-kills the subtree at memory.max directly.
    local wall_deadline=0
    [ -n "$wall" ] && wall_deadline=$(( $(date +%s) + wall ))
    # Monitor loop: poll CPU-time usage + wall deadline; reap cgroup.kill-first on overrun.
    while kill -0 "$runner_pid" 2>/dev/null; do
      local usage_sample=""
      if [ -n "$payload_status_file" ] && [ -f "$payload_status_file" ]; then
        if IFS= read -r status <"$payload_status_file" && \
           [[ $status =~ ^[0-9]+$ ]] && [ "$status" -le 255 ]; then
          payload_completed=1
        else
          status=3
          diag "ERROR: payload exit status was absent or malformed."
        fi
        _pt_freeze_and_capture || true
        _pt_kill_scope
        break
      fi
      if usage_sample="$(_pt_read_usage)"; then
        if [ "$usage_sample" -lt "$maximum_usage" ]; then
          accounting_failed=1
          final_usage_observed=0
          diag "ERROR: observed cgroup CPU counter decreased."
          _pt_kill_scope
          break
        fi
        last_usage="$usage_sample"
        maximum_usage="$usage_sample"
      fi
      if [ "${last_usage:-0}" -gt "$budget_usec" ]; then
        diag "CPU-TIMEOUT: usage_usec=$last_usage exceeded budget=${budget_usec} (${cpu_budget}s) — reaping via cgroup.kill"
        termination="cpu_budget"
        _pt_freeze_and_capture || true
        _pt_kill_scope
        reaped=1
        break
      fi
      if [ "$wall_deadline" -gt 0 ] && [ "$(date +%s)" -ge "$wall_deadline" ]; then
        diag "WALL-TIMEOUT: exceeded ${wall}s wall-clock — reaping via cgroup.kill"
        termination="wall_backstop"
        _pt_freeze_and_capture || true
        _pt_kill_scope
        reaped=1
        break
      fi
      sleep 0.25
    done
  fi

  if [ "$runner_waited" -eq 0 ]; then
    local runner_status=0
    wait "$runner_pid" 2>/dev/null || runner_status=$?
    if [ "$payload_completed" -eq 0 ]; then
      status=$runner_status
    fi
    runner_waited=1
  fi
  # On normal completion, capture the final subtree total while the cgroup
  # still exists. A capped run may already have captured its last observable
  # numeric sample immediately before destructive teardown; a successful
  # post-wait read supersedes that sample.
  if [ "$cgroup_resolved" -eq 1 ]; then
    _pt_capture_final_usage || true
  fi
  if [ -n "$actual_json" ] && [ -n "$receipt_pid" ]; then
    printf '%s\n' "$maximum_usage" >"$hold_dir/cpu.finish.tmp"
    mv -- "$hold_dir/cpu.finish.tmp" "$hold_dir/cpu.finish"
    local receipt_status=0
    wait "$receipt_pid" 2>/dev/null || receipt_status=$?
    receipt_pid=""
    if [ "$receipt_status" -eq 0 ] && [ -f "$hold_dir/cpu.final" ] && \
       read -r completed_cpu_nsec usage_sample <"$hold_dir/cpu.final" && \
       [[ $completed_cpu_nsec =~ ^[0-9]+$ && $usage_sample =~ ^[0-9]+$ ]] && \
       [ "$usage_sample" -ge "$maximum_usage" ]; then
      last_usage="$usage_sample"
      completed_cpu_observed=1
    else
      diag "ERROR: completed scope CPU is missing or below an earlier observation."
    fi
  fi
  # cgroup.kill-FIRST teardown: systemd-run returns when the MAIN scope process exits, but a
  # setsid/double-fork escapee it reparented can still linger in the scope cgroup — the exact
  # leak this wrapper prevents. Sweep the whole scope subtree unconditionally on exit so no
  # process survives us. (Only ever our OWN scope's cgroup.kill; never an external/broad kill.)
  _pt_kill_scope 1
  if [ -n "$hold_dir" ]; then
    rm -f -- "$hold_dir"/cpu.{ready,ready.tmp,finish,finish.tmp,final,final.tmp,readback,readback.tmp,error,error.tmp}
    rm -f -- "$payload_status_file" "$payload_status_file.tmp" \
      "$payload_release_file" 2>/dev/null || true
    rmdir -- "$hold_dir" 2>/dev/null || true
  fi
  local actual_refused=0
  if [ -n "$actual_json" ] && { [ "$cgroup_resolved" -eq 0 ] || [ "$final_usage_observed" -eq 0 ] || [ "$completed_cpu_observed" -eq 0 ] || [ "$accounting_failed" -eq 1 ]; }; then
    actual_refused=1
    status=3
    diag "ERROR: authoritative cgroup CPU unavailable; refusing --actual-json publication."
    echo "hermit-box-run: authoritative cgroup CPU unavailable; refusing --actual-json (exit 3)" >&8
  fi
  if [ "$final_usage_observed" -eq 1 ]; then
    diag "final usage_usec=$last_usage reaped=${reaped} termination=${termination} exit=${status}"
  else
    diag "final usage_usec=unavailable reaped=${reaped} termination=${termination} exit=${status}"
  fi
  if [ -n "$actual_json" ] && [ "$actual_refused" -eq 0 ]; then
    python3 - "$actual_json" "$label" "$unit" "$cpu_budget" "${wall:-0}" \
      "${last_usage:-0}" "$reaped" "$termination" "$status" "$completed_cpu_nsec" <<'PY'
import json
import os
from pathlib import Path
import tempfile
import sys

(
    destination_raw,
    label,
    scope,
    cpu_budget,
    wall_backstop,
    usage_usec,
    reaped,
    termination,
    exit_code,
    completed_cpu_nsec,
) = sys.argv[1:]
destination = Path(destination_raw)
destination.parent.mkdir(parents=True, exist_ok=True)
usage = int(usage_usec)
payload = {
    "schema": "hermit-box-run-actual/v1",
    "label": label,
    "scope": scope,
    "cpu_source": "systemd CPUUsageNSec after scope exit",
    "cpu_usage_nsec": int(completed_cpu_nsec),
    "cgroup_usage_usec": usage,
    "cpu_seconds": usage / 1_000_000,
    "cpu_budget_seconds": int(cpu_budget),
    "wall_backstop_seconds": int(wall_backstop) or None,
    "reaped": bool(int(reaped)),
    "termination": termination,
    "exit_code": int(exit_code),
}
descriptor, temporary_raw = tempfile.mkstemp(
    dir=destination.parent, prefix=f".{destination.name}.", suffix=".tmp"
)
temporary = Path(temporary_raw)
try:
    with os.fdopen(descriptor, "w", encoding="utf-8") as handle:
        json.dump(payload, handle, indent=2, sort_keys=True)
        handle.write("\n")
        handle.flush()
        os.fsync(handle.fileno())
    os.replace(temporary, destination)
    directory = os.open(destination.parent, os.O_RDONLY | os.O_DIRECTORY)
    try:
        os.fsync(directory)
    finally:
        os.close(directory)
except BaseException:
    try:
        temporary.unlink()
    except FileNotFoundError:
        pass
    raise
PY
  fi
  if [ -n "$perf_dir" ]; then
    mkdir -p "$perf_dir" 2>/dev/null || true
    { printf 'label,scope,cpu_budget_s,usage_usec,reaped,exit\n'
      printf '%s,%s,%s,%s,%s,%s\n' "$label" "$unit" "$cpu_budget" "${last_usage:-0}" "$reaped" "$status"
    } >> "$perf_dir/hermit-box-run-passthrough.csv" 2>/dev/null || true
  fi
  exit "$status"   # REAL child exit status (137 on a SIGKILL/cgroup.kill reap); never collapsed.
}

if [ "$passthrough" -eq 1 ]; then
  passthrough_run "$@"
fi

[ -x "$RUNNER" ] || die "runner not found/executable at $RUNNER"

# Build the one-step DAG with correct JSON escaping via python3 (argv passed as $@).
dag_file="$(mktemp -t hermit-box-run.XXXXXX.dag.json)"
cleanup() { rm -f "$dag_file"; }
trap cleanup EXIT
LABEL="$label" CPU_BUDGET="$cpu_budget" WALL="$wall" MEM_BYTES="$mem_bytes" python3 - "$@" > "$dag_file" <<'PY'
import json, os, shlex, sys
argv = sys.argv[1:]
# exec so the boxed step process IS the command (one clean subtree, no extra shell frame).
cmd = "exec " + " ".join(shlex.quote(a) for a in argv)
label = os.environ["LABEL"]
grp, _, job = label.partition(".")
if not job:
    grp, job = "box", label
step = {
    "group": grp, "job": job,
    "desc": "hermit-box-run: " + " ".join(argv),
    "cmd": cmd,
    "cpu_timeout": int(os.environ["CPU_BUDGET"]),  # CPU-time budget (cgroup cpu.stat)
}
wall = os.environ.get("WALL", "")
if wall:  # wall-clock ceiling -> step `timeout` (backstop for a blocked/hung step)
    step["timeout"] = int(wall)
mem = os.environ.get("MEM_BYTES", "")
if mem:  # memory cap -> inner cgroup memory.max (kernel OOM-kills the step at its cap)
    step["hint"] = {"hard_mem_max_bytes": int(mem)}
json.dump({"steps": [step]}, sys.stdout)
PY

set -- run --dag "$dag_file" --no-profile
[ -n "$cores" ] && set -- "$@" --cores "$cores"
[ -n "$perf_dir" ] && set -- "$@" --perf-dir "$perf_dir"
[ "$allow_cgroup_failure" -eq 1 ] && set -- "$@" --allow-cgroup-failure

# Run the runner as a CHILD (not `exec`) so the EXIT trap fires and the temp DAG is
# DISCARDED — the task's "generate temp JSON, run once, discard" contract. `exec` would
# replace this shell and skip the trap, leaking one dag.json per invocation. The runner
# re-execs itself into its own transient systemd scope, so keeping this thin parent frame
# alive to wait + clean up does not weaken the boxing. Propagate the runner's exit verbatim.
rc=0
"$RUNNER" "$@" || rc=$?
exit "$rc"
