#!/usr/bin/env bash

set -euo pipefail

script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
repo_root=$(cd -- "$script_dir/.." && pwd)
third_party_dir=$repo_root/shim/third-party/rust

cd "$repo_root"

if [[ ! -f Cargo.lock ]] || ! git ls-files --error-unmatch Cargo.lock >/dev/null 2>&1; then
  echo "Cargo.lock must exist and be tracked before Buck dependencies are generated" >&2
  exit 1
fi

if [[ ! -f reverie/bootstrap/regenerate-rust-deps ]]; then
  echo "initialize the pinned reverie submodule before generating Buck dependencies" >&2
  exit 1
fi

cargo metadata --locked --format-version 1 --no-deps >/dev/null

# A fresh checkout has none of these generated paths. Removing only paths that
# Git confirms are excluded makes repeated local use take the same path.
for generated in \
  "$third_party_dir/.cargo" \
  "$third_party_dir/BUCK" \
  "$third_party_dir/vendor"
do
  relative=${generated#"$repo_root/"}
  if [[ -e $generated ]] && ! git check-ignore -q "$relative"; then
    echo "refusing to remove non-ignored path: $relative" >&2
    exit 1
  fi
done
rm -rf -- \
  "$third_party_dir/.cargo" \
  "$third_party_dir/BUCK" \
  "$third_party_dir/vendor"

reindeer_args=(
  --third-party-dir "$third_party_dir"
  --manifest-path "$repo_root/Cargo.toml"
)

"$script_dir/reindeer" "${reindeer_args[@]}" vendor

first_output=$(mktemp)
trap 'rm -f -- "$first_output"' EXIT
"$script_dir/reindeer" "${reindeer_args[@]}" buckify --stdout >"$first_output"
"$script_dir/reindeer" "${reindeer_args[@]}" buckify
cmp --silent "$first_output" "$third_party_dir/BUCK" || {
  echo "Reindeer produced different BUCK output across consecutive invocations" >&2
  exit 1
}

git diff --exit-code -- Cargo.lock

# Hermit's BUCK files consume Reverie as a separate cell. Generate its own
# authoritative dependency graph rather than synthesizing or sharing one.
"$repo_root/reverie/bootstrap/regenerate-rust-deps"

sha256sum \
  Cargo.lock \
  "$third_party_dir/BUCK" \
  reverie/Cargo.lock \
  reverie/shim/third-party/rust/BUCK
