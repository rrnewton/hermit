+fn append_record_lockdown_args(argv: &mut Vec<String>) {
+    // Record/replay stores the cwd in its launch metadata and recreates it in
+    // the replay root. The outer validation mount namespace provides an empty
+    // `/test`, so the required replay cell needs no new mount surface here.
+    argv.push(format!("--workdir={PRIVATE_WORKDIR}"));
+}
