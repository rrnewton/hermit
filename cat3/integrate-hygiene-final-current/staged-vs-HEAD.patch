+        .chain(plan.second.iter())
+        .flat_map(|cfg| cfg.steps.iter())
+        .filter(|step| {
+            step.env.contains_key(PRIVATE_TEST_ROOT_ENV)
+                || step.env.contains_key(PRIVATE_TEST_ROOT_HELPER_ENV)
+                || step.env.contains_key(PRIVATE_TEST_ROOT_HELPER_SHA256_ENV)
+        })
