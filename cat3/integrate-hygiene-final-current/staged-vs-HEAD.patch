+        argv.push(format!(
+            "--mount=type=bind,source={},target={},readonly",
+            mount.source.display(),
+            mount.target.display()
+        ));
+    }
+    argv.push(format!("--mount=type=tmpfs,target={PRIVATE_WORKDIR}"));
+    argv.push(format!("--workdir={PRIVATE_WORKDIR}"));
