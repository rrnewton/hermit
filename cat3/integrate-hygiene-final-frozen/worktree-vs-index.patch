+    };
+    let _ = std::fs::remove_dir_all(&scratch);
+    if let Some(failure) = failure {
+        return Err(format!(
+            "top-level {mode} cleanup probe failed: {failure}\nstdout:\n{out}\nstderr:\n{err}"
+        ));
+    }
