+fn validate_ephemeral_test_root_lease_tuple(value: &str) -> Result<(), String> {
+    let fields = value.split(':').collect::<Vec<_>>();
+    if fields.len() != 8
+        || fields[0] != "v2"
+        || fields[1..]
+            .iter()
+            .any(|field| field.is_empty() || !field.bytes().all(|byte| byte.is_ascii_digit()))
+    {
+        return Err("malformed internal /test lease argument".into());
+    }
+    Ok(())
+}
+
+fn extract_ephemeral_test_root_lease_argument(
+    argv: Vec<String>,
+) -> Result<(Vec<String>, Option<String>), String> {
+    let mut ordinary = Vec::with_capacity(argv.len());
+    let mut lease = None;
+    for argument in argv {
+        if argument.starts_with(EPHEMERAL_TEST_ROOT_LEASE_ARG) {
+            let value = argument
+                .strip_prefix(EPHEMERAL_TEST_ROOT_LEASE_ARG)
+                .and_then(|suffix| suffix.strip_prefix('='))
+                .ok_or("malformed internal /test lease argument")?;
+            validate_ephemeral_test_root_lease_tuple(value)?;
+            if lease.replace(value.to_string()).is_some() {
+                return Err("duplicate internal /test lease argument".into());
+            }
+        } else {
+            ordinary.push(argument);
+        }
+    }
+    Ok((ordinary, lease))
+}
+
+#[derive(Clone, Debug, Default)]
+struct EphemeralTestRootLeaseInput {
+    tuple: Option<String>,
+    carried_by_argv: bool,
+}
+
+fn capture_ephemeral_test_root_lease_input(
+    carried_lease: Option<&str>,
+) -> Result<EphemeralTestRootLeaseInput, String> {
+    let ambient = env::var_os(EPHEMERAL_TEST_ROOT_LEASE_ENV);
+    env::remove_var(EPHEMERAL_TEST_ROOT_LEASE_ENV);
+    let ambient = ambient
+        .map(|value| {
+            value
+                .into_string()
+                .map_err(|_| "inherited /test lease is not valid UTF-8".to_string())
+        })
+        .transpose()?;
+    if let Some(value) = carried_lease {
+        validate_ephemeral_test_root_lease_tuple(value)?;
+    }
+    if let Some(value) = ambient.as_deref() {
+        validate_ephemeral_test_root_lease_tuple(value)?;
+    }
+    if let (Some(carried), Some(ambient)) = (carried_lease, ambient.as_deref()) {
+        if carried != ambient {
+            return Err("internal /test lease argument does not match the inherited lease".into());
+        }
+    }
+    Ok(EphemeralTestRootLeaseInput {
+        tuple: carried_lease.map(str::to_owned).or(ambient),
+        carried_by_argv: carried_lease.is_some(),
+    })
+}
+
+fn validate_ephemeral_test_root_lease(root: &Path, lease: &str) -> Result<(), String> {
+    let status = Command::new(root.join("ci/run-with-ephemeral-test-root.sh"))
+        .arg("--check-lease")
+        .env(EPHEMERAL_TEST_ROOT_LEASE_ENV, lease)
+        .status()
+        .map_err(|error| format!("cannot validate inherited /test lease: {error}"))?;
+    if status.success() {
+        Ok(())
+    } else {
+        Err(format!(
+            "carried /test lease validation failed with {status}; refusing unowned /test state"
+        ))
+    }
+}
+
+fn ensure_pressure_ephemeral_test_root(
+    root: &Path,
+    lease_input: &EphemeralTestRootLeaseInput,
+) -> Result<String, String> {
+    let wrapper = root.join("ci/run-with-ephemeral-test-root.sh");
+    if let Some(lease) = lease_input.tuple.as_deref() {
+        validate_ephemeral_test_root_lease(root, lease)?;
+        if lease_input.carried_by_argv || dagrun::cgroup::is_in_scope() {
+            return Ok(lease.to_string());
+        }
+    }
+    if dagrun::cgroup::is_in_scope() {
+        return Err(
+            "in-scope pressure run has neither a validated inherited lease nor a pre-scope lease token"
+                .into(),
+        );
+    }
+    let executable = env::current_exe()
+        .map_err(|error| format!("cannot resolve pressure-test executable: {error}"))?;
+    let mut command = Command::new(&wrapper);
+    command
+        .arg("--forward-lease-argv")
+        .arg("--")
+        .arg(executable)
+        .args(env::args().skip(1))
+        .env_remove(EPHEMERAL_TEST_ROOT_LEASE_ENV);
+    if let Some(lease) = lease_input.tuple.as_deref() {
+        command.env(EPHEMERAL_TEST_ROOT_LEASE_ENV, lease);
+    }
+    let error = command.exec();
+    Err(format!(
+        "cannot re-exec pressure run through {}: {error}",
+        wrapper.display()
+    ))
+}
+
+fn export_ephemeral_test_root_lease_for_children(
+    root: &Path,
+    lease: &str,
+) -> Result<(), String> {
+    validate_ephemeral_test_root_lease(root, lease)?;
+    env::set_var(EPHEMERAL_TEST_ROOT_LEASE_ENV, lease);
+    Ok(())
+}
+
+fn process_identity(pid: i32) -> Option<(char, u64)> {
+    let stat = fs::read_to_string(format!("/proc/{pid}/stat")).ok()?;
+    let close = stat.rfind(')')?;
+    let fields = stat.get(close + 1..)?.split_whitespace().collect::<Vec<_>>();
+    Some((
+        fields.first()?.chars().next()?,
+        fields.get(19)?.parse().ok()?,
+    ))
+}
+
+fn matching_process_identity_is_live(observed: Option<(char, u64)>, expected_start: u64) -> bool {
+    observed.is_some_and(|(state, start)| state != 'Z' && start == expected_start)
+}
+
+fn run_pressure_scope_cleanup_payload(
+    root: &Path,
+    lease_input: &EphemeralTestRootLeaseInput,
+    mode: &str,
+) -> Result<(), String> {
+    let lease = ensure_pressure_ephemeral_test_root(root, lease_input)?;
+    let runtime = if mode == PRESSURE_SCOPE_PROBE_RUNTIME {
+        PRESSURE_SCOPE_PROBE_RUNTIME_S
+    } else {
+        30
+    };
+    safe_ci_scope::ensure_scope_reexec(
+        "compatibility pressure cleanup probe",
+        false,
+        Some(runtime),
+    )
+    .map_err(|code| format!("pressure cleanup scope re-exec refused with exit {code}"))?;
+    export_ephemeral_test_root_lease_for_children(root, &lease)?;
+    let _cgroups = safe_ci_scope::resolve_cgroups_after_reexec(
+        "compatibility pressure cleanup probe",
+        false,
+        true,
+    )
+    .map_err(|code| format!("pressure cleanup cgroup setup refused with exit {code}"))?;
+    let attempt = dagrun::cgroup::attempt_scope_reexec(None, None, None);
+    let proof = attempt
+        .proof()
+        .ok_or_else(|| format!("pressure cleanup lost scope proof: {}", attempt.describe()))?;
+    let unit = proof
+        .unit
+        .as_deref()
+        .ok_or("pressure cleanup scope proof has no promised unit")?;
+    let scope = proof
+        .cgroup
+        .ancestors()
+        .find(|path| path.file_name().and_then(|name| name.to_str()) == Some(unit))
+        .ok_or("pressure cleanup cannot locate promised scope ancestor")?
+        .to_path_buf();
+    let ready = env::var(PRESSURE_SCOPE_PROBE_READY_ENV)
+        .map(PathBuf::from)
+        .map_err(|_| "pressure cleanup probe has no ready path".to_string())?;
+    let _survivor = env::var(PRESSURE_SCOPE_PROBE_SURVIVOR_ENV)
+        .map(PathBuf::from)
+        .map_err(|_| "pressure cleanup probe has no survivor path".to_string())?;
+    unsafe {
+        libc::signal(libc::SIGTERM, libc::SIG_DFL);
+    }
+    let descendant = Command::new("/usr/bin/sleep")
+        .arg("15")
+        .spawn()
+        .map_err(|error| format!("cannot launch pressure cleanup descendant: {error}"))?;
+    let descendant_pid = descendant.id() as i32;
+    let descendant_start = process_identity(descendant_pid)
+        .map(|(_, start)| start)
+        .ok_or("cannot bind pressure cleanup descendant to start ticks")?;
+    fs::write(
+        &ready,
+        format!(
+            "{descendant_pid}:{descendant_start}\n{}\n",
+            scope.display()
+        ),
+    )
+    .map_err(|error| format!("cannot publish pressure cleanup readiness: {error}"))?;
+    drop(descendant);
+    loop {
+        std::thread::sleep(std::time::Duration::from_secs(1));
+    }
+}
+
+fn pressure_scope_cleanup_probe(
+    root: &Path,
+    mode: &str,
+    send_signal: bool,
+    lease: &str,
+) -> Result<(), String> {
+    validate_ephemeral_test_root_lease(root, lease)?;
+    let nonce = SystemTime::now()
+        .duration_since(UNIX_EPOCH)
+        .map_err(|error| format!("pressure cleanup clock failure: {error}"))?
+        .as_nanos();
+    let scratch = env::temp_dir().join(format!(
+        "pressure-top-level-{mode}-{}-{nonce}",
+        std::process::id()
+    ));
+    fs::create_dir(&scratch)
+        .map_err(|error| format!("cannot create pressure cleanup scratch: {error}"))?;
+    let ready = scratch.join("ready");
+    let survivor = scratch.join("survivor");
+    let stdout = scratch.join("stdout");
+    let stderr = scratch.join("stderr");
+    let exe = env::current_exe()
+        .map_err(|error| format!("cannot resolve pressure cleanup executable: {error}"))?;
+    let mut command = Command::new(exe);
+    let mut child = command
+        .arg("self-test")
+        .arg(format!("{EPHEMERAL_TEST_ROOT_LEASE_ARG}={lease}"))
+        .env(PRESSURE_SCOPE_CLEANUP_PROBE_ENV, mode)
+        .env(PRESSURE_SCOPE_PROBE_READY_ENV, &ready)
+        .env(PRESSURE_SCOPE_PROBE_SURVIVOR_ENV, &survivor)
+        .env("DAGRUN_FORCE_SCOPE_ATTEMPT", "1")
+        .env_remove(EPHEMERAL_TEST_ROOT_LEASE_ENV)
+        .env_remove("DAGRUN_IN_SCOPE")
+        .env_remove("DAGRUN_SCOPE_UNIT")
+        .env_remove("DAGRUN_EXPECTED_OUTER_MEMORY_MAX_BYTES")
+        .env_remove("DAGRUN_EXPECTED_RUNTIME_MAX_SEC")
+        .process_group(0)
+        .stdout(
+            fs::File::create(&stdout)
+                .map_err(|error| format!("cannot create pressure cleanup stdout: {error}"))?,
+        )
+        .stderr(
+            fs::File::create(&stderr)
+                .map_err(|error| format!("cannot create pressure cleanup stderr: {error}"))?,
+        )
+        .spawn()
+        .map_err(|error| format!("cannot launch pressure {mode} cleanup probe: {error}"))?;
+    let deadline = Instant::now() + std::time::Duration::from_secs(PRESSURE_SCOPE_PROBE_DEADLINE_S);
+    while !ready.is_file() {
+        if let Some(status) = child
+            .try_wait()
+            .map_err(|error| format!("cannot poll pressure {mode} cleanup probe: {error}"))?
+        {
+            let out = fs::read_to_string(&stdout).unwrap_or_default();
+            let err = fs::read_to_string(&stderr).unwrap_or_default();
+            let _ = fs::remove_dir_all(&scratch);
+            return Err(format!(
+                "pressure {mode} cleanup probe exited {status} before readiness\nstdout:\n{out}\nstderr:\n{err}"
+            ));
+        }
+        if Instant::now() >= deadline {
+            unsafe {
+                libc::kill(-(child.id() as i32), libc::SIGTERM);
+            }
+            let _ = child.wait();
+            return Err(format!(
+                "pressure {mode} cleanup probe did not become ready within {PRESSURE_SCOPE_PROBE_DEADLINE_S}s"
+            ));
+        }
+        std::thread::sleep(std::time::Duration::from_millis(50));
+    }
+    let descendant_identity = fs::read_to_string(&ready)
+        .map_err(|error| format!("cannot read pressure {mode} descendant identity: {error}"))?;
+    let mut identity_lines = descendant_identity.lines();
+    let (descendant_pid, descendant_start) = identity_lines
+        .next()
+        .and_then(|identity| identity.split_once(':'))
+        .and_then(|(pid, start)| Some((pid.parse::<i32>().ok()?, start.parse::<u64>().ok()?)))
+        .ok_or_else(|| format!("pressure {mode} emitted malformed descendant identity"))?;
+    let scope = identity_lines
+        .next()
+        .map(PathBuf::from)
+        .filter(|path| path.is_absolute())
+        .ok_or_else(|| format!("pressure {mode} emitted malformed scope identity"))?;
+    if send_signal {
+        let rc = unsafe { libc::kill(-(child.id() as i32), libc::SIGTERM) };
+        if rc != 0 {
+            return Err(format!(
+                "cannot signal pressure {mode} wrapper: {}",
+                std::io::Error::last_os_error()
+            ));
+        }
+    }
+    let status = loop {
+        if let Some(status) = child
+            .try_wait()
+            .map_err(|error| format!("cannot poll pressure {mode} cleanup probe: {error}"))?
+        {
+            break status;
+        }
+        if Instant::now() >= deadline {
+            unsafe {
+                libc::kill(-(child.id() as i32), libc::SIGTERM);
+            }
+            let _ = child.wait();
+            return Err(format!(
+                "pressure {mode} cleanup probe exceeded {PRESSURE_SCOPE_PROBE_DEADLINE_S}s"
+            ));
+        }
+        std::thread::sleep(std::time::Duration::from_millis(50));
+    };
+    let out = fs::read_to_string(&stdout).unwrap_or_default();
+    let err = fs::read_to_string(&stderr).unwrap_or_default();
+    let scope_empty = if scope.exists() {
+        fs::read_to_string(scope.join("cgroup.events"))
+            .ok()
+            .is_some_and(|events| events.lines().any(|line| line == "populated 0"))
+    } else {
+        true
+    };
+    let expected_term = send_signal
+        && (status.code() == Some(128 + libc::SIGTERM)
+            || status.signal() == Some(libc::SIGTERM));
+    let runtime_evidence = out.contains("RuntimeMaxSec=5s") || err.contains("RuntimeMaxSec=5s");
+    let failure = if status.success() {
+        Some("scoped pressure payload unexpectedly exited successfully".to_string())
+    } else if send_signal && !expected_term {
+        Some(format!(
+            "scoped pressure driver did not terminate by SIGTERM: {status}"
+        ))
+    } else if !send_signal && !runtime_evidence {
+        Some("pressure RuntimeMax probe emitted no enforced RuntimeMaxSec=5s evidence".to_string())
+    } else if matching_process_identity_is_live(process_identity(descendant_pid), descendant_start)
+    {
+        Some(format!(
+            "scoped pressure descendant {descendant_pid}@{descendant_start} remained live after wrapper exit"
+        ))
+    } else if let Err(error) = validate_ephemeral_test_root_lease(root, lease) {
+        Some(format!(
+            "outside-scope owner lost its exact /test lease after pressure termination: {error}"
+        ))
+    } else if !scope_empty {
+        Some(format!(
+            "pressure scope {} still exists without cgroup.events populated 0",
+            scope.display()
+        ))
+    } else {
+        None
+    };
+    let _ = fs::remove_dir_all(&scratch);
+    if let Some(failure) = failure {
+        return Err(format!(
+            "pressure {mode} cleanup probe failed: {failure}\nstdout:\n{out}\nstderr:\n{err}"
+        ));
+    }
+    println!(
+        "pressure {mode}: scoped subtree terminated, outside wrapper remained live, exact /test lease intact"
+    );
+    let _ = root;
+    Ok(())
+}
