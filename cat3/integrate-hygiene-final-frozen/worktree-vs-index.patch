+        ))
+    } else if !send_signal && !runtime_evidence {
+        Some("RuntimeMax cleanup probe emitted no enforced RuntimeMaxSec=5s evidence".to_string())
+    } else if matching_process_identity_is_live(
+        validate_runtime::process_identity(descendant_pid),
