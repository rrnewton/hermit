+fn validate_ephemeral_test_root_lease_tuple(value: &str) -> Result<(), String> {
+    let fields = value.split(':').collect::<Vec<_>>();
+    if fields.len() != 8
+        || fields[0] != "v2"
+        || fields[1..]
+            .iter()
+            .any(|field| field.is_empty() || !field.bytes().all(|byte| byte.is_ascii_digit()))
+    {
+        return Err("malformed internal /test lease argument".into());
+    }
+    Ok(())
+}
+
+#[derive(Clone, Debug, Default)]
+struct EphemeralTestRootLeaseInput {
+    tuple: Option<String>,
+    carried_by_argv: bool,
+}
+
+fn capture_ephemeral_test_root_lease_input(
+    carried_lease: Option<&str>,
+) -> Result<EphemeralTestRootLeaseInput, String> {
+    let ambient = std::env::var_os(EPHEMERAL_TEST_ROOT_LEASE_ENV);
+    std::env::remove_var(EPHEMERAL_TEST_ROOT_LEASE_ENV);
+    let ambient = ambient
+        .map(|value| {
+            value
+                .into_string()
+                .map_err(|_| "inherited /test lease is not valid UTF-8".to_string())
+        })
+        .transpose()?;
+    if let Some(value) = carried_lease {
+        validate_ephemeral_test_root_lease_tuple(value)?;
+    }
+    if let Some(value) = ambient.as_deref() {
+        validate_ephemeral_test_root_lease_tuple(value)?;
+    }
+    if let (Some(carried), Some(ambient)) = (carried_lease, ambient.as_deref()) {
+        if carried != ambient {
+            return Err("internal /test lease argument does not match the inherited lease".into());
+        }
+    }
+    Ok(EphemeralTestRootLeaseInput {
+        tuple: carried_lease.map(str::to_owned).or(ambient),
+        carried_by_argv: carried_lease.is_some(),
+    })
+}
+
+fn validate_ephemeral_test_root_lease(
+    root: &Path,
