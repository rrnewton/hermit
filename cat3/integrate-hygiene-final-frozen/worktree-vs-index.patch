+#[derive(Clone, Debug, Eq, PartialEq)]
+struct PrivateTestRootHelperDecision {
+    helper_sha256: String,
+    target: String,
+    owner_pid: u32,
+    owner_start_ticks: u64,
+    authority_sha256: String,
+}
+
+impl PrivateTestRootHelperDecision {
+    fn encode(&self) -> String {
+        format!(
+            "v1:{}:{}:{}:{}:{}",
+            self.helper_sha256,
+            self.target,
+            self.owner_pid,
+            self.owner_start_ticks,
+            self.authority_sha256
+        )
+    }
+
+    fn parse(value: &str) -> Result<Self, String> {
+        let fields = value.split(':').collect::<Vec<_>>();
+        if fields.len() != 6 || fields[0] != "v1" {
+            return Err("malformed internal helper decision argument".into());
+        }
+        let helper_sha256 = fields[1].to_string();
+        let target = fields[2].to_string();
+        let owner_pid = fields[3]
+            .parse::<u32>()
+            .ok()
+            .filter(|pid| *pid > 1)
+            .ok_or("malformed internal helper decision owner pid")?;
+        let owner_start_ticks = fields[4]
+            .parse::<u64>()
+            .ok()
+            .filter(|ticks| *ticks > 0)
+            .ok_or("malformed internal helper decision owner start")?;
+        let authority_sha256 = fields[5].to_string();
+        if !is_lower_hex(&helper_sha256, 64)
+            || !is_lower_hex(&target, 40)
+            || !is_lower_hex(&authority_sha256, 64)
+        {
+            return Err("malformed internal helper decision digest/target".into());
+        }
+        Ok(Self {
+            helper_sha256,
+            target,
+            owner_pid,
+            owner_start_ticks,
+            authority_sha256,
+        })
+    }
 }
 
