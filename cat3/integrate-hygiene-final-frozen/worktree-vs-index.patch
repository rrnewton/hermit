+            "scoped descendant {descendant_pid}@{descendant_start} remained live after wrapper exit"
+        ))
+    } else if let Err(error) = validate_ephemeral_test_root_lease(&repo_root(), lease) {
+        Some(format!(
+            "outside-scope owner lost its exact /test lease after scoped termination: {error}"
+        ))
