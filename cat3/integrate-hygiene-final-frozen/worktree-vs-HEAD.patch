+        .map_err(|error| format!("cannot resolve validate executable for helper re-exec: {error}"))?;
+    let error = Command::new(executable)
+        .args(std::env::args().skip(1))
+        .arg(format!(
+            "{PRIVATE_TEST_ROOT_HELPER_DECISION_ARG}={}",
+            helper.decision.encode()
