+                ));
+            }
+            std::path::absolute(root.join(relative))
+                .map(|path| path.to_string_lossy().into_owned())
+                .map_err(|error| {
+                    format!("cannot resolve explicit checkout argument {argument}: {error}")
+                })
+        })
+        .collect()
