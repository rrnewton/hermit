+fn ensure_private_test_root_helper_decision(
+    helper: &PrivateTestRootHelper,
+    carried: Option<&PrivateTestRootHelperDecision>,
+) -> Result<(), String> {
+    if let Some(carried) = carried {
+        if carried != &helper.decision {
+            return Err(
+                "helper-backed /test authority changed after the pre-scope decision".into(),
+            );
+        }
