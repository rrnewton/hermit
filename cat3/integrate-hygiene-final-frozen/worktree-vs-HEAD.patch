+/// The private `/test` root is intentionally narrower than "an E2E command".
+/// It is canonical validation policy, so it applies only to an admitted,
+/// top-level, complete full profile. Focused and nested invocations remain
+/// diagnostic payloads and must not acquire canonical behavior by inheriting an
+/// environment variable.
+fn private_test_root_helper_policy(
+    args: &Args,
+    nested: bool,
+    lock_admitted: bool,
+    plan_requires_private_test_root: bool,
+) -> PrivateTestRootHelperPolicy {
+    if !lock_admitted || nested || !plan_requires_private_test_root {
+        return PrivateTestRootHelperPolicy::Disabled;
+    }
+    if args.private_test_root_eligible && args.level == Level::Full && args.focused.is_none() {
+        return PrivateTestRootHelperPolicy::Required;
+    }
+    if matches!(
+        args.focused,
+        Some(Focused::Only { .. } | Focused::Selective { .. })
+    ) {
+        return PrivateTestRootHelperPolicy::Optional;
+    }
+    PrivateTestRootHelperPolicy::Disabled
+}
+
+fn private_test_root_activation(
+    policy: PrivateTestRootHelperPolicy,
+    helper_available: bool,
+) -> PrivateTestRootActivation {
+    if helper_available && policy != PrivateTestRootHelperPolicy::Disabled {
+        PrivateTestRootActivation::HelperBacked
+    } else {
+        PrivateTestRootActivation::Disabled
+    }
+}
+
+fn private_test_root_allows_cache(
+    activation: PrivateTestRootActivation,
+    canonical_authority_expected: bool,
+) -> bool {
+    !canonical_authority_expected && activation == PrivateTestRootActivation::Disabled
+}
