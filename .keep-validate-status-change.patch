+fn shell_single_quote(value: &str) -> String {
+    format!("'{}'", value.replace('\'', "'\\''"))
+}
+
+fn current_main_diagnostic_command() -> &'static str {
+    "ci-hub validate-status --current-main --diagnostic"
+}
+
+fn current_main_admission_command(
+    sha: &str,
+    run_handles: &[ValidateRunAttempt],
+) -> Option<String> {
+    let agent = run_handles
+        .iter()
+        .find_map(|attempt| attempt.agent.as_deref().filter(|agent| !agent.is_empty()))?;
+    Some(format!(
+        "ci-hub validate-lock admission-status --agent {} --kind validate --target {sha} --target-was-fetched-main --json",
+        shell_single_quote(agent)
+    ))
+}
+
+fn current_main_status_lines(
+    sha: &str,
+    in_progress_count: usize,
+    answer_known: bool,
+    run_handles: &[ValidateRunAttempt],
+    unreadable_handles: &[validate_run_handle::UnreadableRecord],
+    diagnostic: bool,
+) -> Vec<String> {
+    let answer = if answer_known {
+        if in_progress_count > 0 { "yes" } else { "no" }
+    } else {
+        "unknown"
+    };
+    let mut lines = vec![format!(
+        "CURRENT-MAIN {sha} VALIDATE-IN-PROGRESS={answer}{}",
+        answer_known
+            .then(|| format!(" COUNT={in_progress_count}"))
+            .unwrap_or_default()
+    )];
+
+    if !unreadable_handles.is_empty() {
+        lines.push(format!(
+            "RUN-HANDLES UNREADABLE={} -- {}",
+            unreadable_handles.len(),
+            if diagnostic {
+                "individual records follow"
+            } else {
+                "individual records hidden; run `ci-hub validate-status --current-main --diagnostic`"
+            }
+        ));
+    }
+
+    for attempt in run_handles {
+        lines.push(format!(
+            "RUN-HANDLE unit={} state={} head={} agent={} slot={} log={} started={} process_verified={}",
+            attempt.unit,
+            attempt.state,
+            attempt.sha,
+            attempt.agent.as_deref().unwrap_or("?"),
+            attempt.slot.as_deref().unwrap_or("?"),
+            attempt.log_file.as_deref().unwrap_or("?"),
+            attempt.started_at,
+            attempt.process_verified,
+        ));
+    }
+
+    if diagnostic {
+        lines.extend(unreadable_handles.iter().map(unreadable_run_handle_line));
+    }
+
+    if !answer_known {
+        let (command, purpose) = current_main_admission_command(sha, run_handles).map_or_else(
+            || (
+                current_main_diagnostic_command().to_string(),
+                "identify the unreadable run records",
+            ),
+            |command| (command, "inspect admission for this exact commit"),
+        );
+        lines.push(format!("NEXT run `{command}` to {purpose}."));
+    }
+    lines
+}
