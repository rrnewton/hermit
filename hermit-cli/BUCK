buck_sh_test(
    name = "test_record_uptime",
    args = [
        "record",
        "start",
        "--verify",
        "--",
        "cat",
        "/proc/uptime",
    ],
    test = ":hermit",
)

buck_sh_test(
    name = "test_record_dev_urandom",
    args = [
        "record",
        "start",
        "--verify",
        "--",
        "hexdump",
        "-C",
        "-n",
        "32",
        "/dev/urandom",
    ],
    test = ":hermit",
)

buck_sh_test(
    name = "test_record_with_gdb_smoke",
    args = [
        "record",
        "start",
        "--verify-with-gdbex='b main; c; c'",
        "--",
        "hexdump",
        "-C",
        "-n",
        "32",
        "/dev/urandom",
    ],
    test = ":hermit",
)
