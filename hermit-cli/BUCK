rust_binary(
    name = "_hermit-release",
    srcs = glob(["src/bin/**/*.rs"]),
    crate = "hermit",
    env = release_build_env,
    features = [
        "buck-release-provenance",
        "dbt",
        "e9patch",
        "sabre",
    ],
    link_style = "static_pic",
    rustc_flags = [
        "-C",
        "link-arg=-Wl,--disable-new-dtags",
        "-C",
        "link-arg=-Wl,-rpath,$ORIGIN/../install_pkg/rsrcs/hermit-runtime:$ORIGIN/install/rsrcs/hermit-runtime",
    ],
    # The guarded local producer overrides this with its content-bound prebuilt
    # target. CI resolves the default declared pkg-config dependency.
    deps = [release_lzma_target, release_unwind_target] + [
        "fbsource//third-party/rust:anyhow",
        "fbsource//third-party/rust:bincode",
        "fbsource//third-party/rust:clap",
        "fbsource//third-party/rust:colored",
        "fbsource//third-party/rust:diff",
        "fbsource//third-party/rust:dirs",
        "fbsource//third-party/rust:libc",
        "fbsource//third-party/rust:nix",
        "fbsource//third-party/rust:num_cpus",
        "fbsource//third-party/rust:pretty_assertions",
        "fbsource//third-party/rust:rand",
        "fbsource//third-party/rust:rand_pcg",
        "fbsource//third-party/rust:regex",
        "fbsource//third-party/rust:reverie-dbt",
        "fbsource//third-party/rust:serde",
        "fbsource//third-party/rust:serde_json",
        "fbsource//third-party/rust:shell-words",
        "fbsource//third-party/rust:tempfile",
        "fbsource//third-party/rust:tokio",
        "fbsource//third-party/rust:tracing",
        "fbsource//third-party/rust:tracing-appender",
        "fbsource//third-party/rust:tracing-subscriber",
        "fbsource//third-party/rust:uuid",
        ":_libhermit-release",
        "//common/rust/build_info:build_info",
