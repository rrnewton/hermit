# Single source of truth for the Reverie DBI build-budget calibration.
#
# WHY THIS FILE EXISTS. The budget used to be bound by hardcoding the Reverie
# pin in three separate places (ci/run-with-reverie-dbi-budget.sh,
# ci/configure-build-jobs.sh, ci/test_harness.sh). That made every Reverie pin
# bump break the portable, privileged and merge-gate lanes until a human
# hand-edited all three and wrote a "CARRY TO <pin>" paragraph justifying it --
# six such paragraphs had accumulated in configure-build-jobs.sh.
#
# The deeper problem was not the duplication but the binding. The budget
# governs exactly one quantity: the elapsed time reverie-dbi/build.rs reports
# for a DynamoRIO content-key MISS. That cost is determined by the DynamoRIO
# build recipe, NOT by the Reverie revision. Across the six recorded carries
# the Reverie pin changed six times and the recipe key changed zero times, so
# the pin was a correlated proxy that was wrong every single time it fired.
#
# So the calibration is keyed on the recipe inputs below. Any pin whose recipe
# inputs match is accepted without a human edit; a pin that actually changes a
# DynamoRIO build input is refused and demands re-measurement. That is the true
# condition, and it is observable rather than inferred.

# The DynamoRIO recipe identity reverie-dbi/build.rs computes via
# source_recipe_key() over {vendor/dynamorio, build.rs, $CMAKE,
# $CMAKE_GENERATOR}. Recorded for provenance and for the budget log line; the
# runtime check uses the input object ids below, because the key itself is only
# observable once the build is already running.
REVERIE_DBI_CALIBRATED_RECIPE_KEY=76403e8e76b128119be4a7192893b7ec3084aeb85f4bd0377198a538d94b2a1d

# Git object ids of the recipe inputs, in the Reverie repository. These are what
# the runtime check compares, because they are resolvable BEFORE the build from
# the Cargo git database. $CMAKE and $CMAKE_GENERATOR are deliberately excluded:
# source_recipe_key() folds them in, but they are host environment rather than
# repository content, and the portable lane leaves both unset.
REVERIE_DBI_CALIBRATED_BUILD_RS=9e35e1b699b76d8b9f8a6adacc21c7a095f4f8f7
REVERIE_DBI_CALIBRATED_VENDOR_DYNAMORIO=de352475846e385002c1e4e54604fa0a7647b2de
REVERIE_DBI_CALIBRATED_THIRD_PARTY=fb49c0ba7a9abd48a4ea662bf20e08246c81fc5a

# The pin the surviving timing measurement was taken against, and the pin the
# calibration has been carried to most recently. The first is measurement
# provenance and must not be advanced without re-measuring; the second is
# bookkeeping and is the conservative fallback when the recipe inputs cannot be
# resolved offline (see reverie_dbi_budget_pin_is_calibrated below).
REVERIE_DBI_CALIBRATED_MEASURED_AT_PIN=025d378
REVERIE_DBI_CALIBRATED_PIN=038e993926e45514264d30367b70df9b6ac3b9b8

# Provenance of the measured threshold itself. Unchanged by a carry.
REVERIE_DBI_CALIBRATED_BASIS=github-portable-cold-miss-n3-affinity4

# Decide whether $1 (a recorded Reverie pin) is covered by this calibration.
#
# DERIVATION FIRST, WITH A FALLBACK THAT IS NEVER LOOSER THAN THE OLD CHECK:
#   - recipe inputs resolvable and identical  -> accept (prints "recipe-inputs")
#   - recipe inputs resolvable and different  -> refuse; re-measurement required
#   - recipe inputs NOT resolvable offline    -> fall back to exact-pin equality
#     against REVERIE_DBI_CALIBRATED_PIN, i.e. exactly the previous behaviour
#
# The fallback matters because the Cargo git database only exists after Cargo
# has fetched Reverie at least once. On a cold runner this wrapper can run
# first, and a check that fail-closed there would red the lane for a reason
# unrelated to the budget. Falling back to the old rule cannot be less strict
# than what shipped before, so the fallback can only ever refuse things the old
# code also refused.
reverie_dbi_budget_pin_is_calibrated() {
    local recorded_pin=$1
    local db
    db=$(compgen -G "${CARGO_HOME:-$HOME/.cargo}/git/db/reverie-*" 2>/dev/null | head -1 || true)

    if [[ -n $db ]] && git --git-dir="$db" cat-file -e "${recorded_pin}^{commit}" 2>/dev/null; then
        local build_rs vendor third_party
        build_rs=$(git --git-dir="$db" rev-parse "${recorded_pin}:reverie-dbi/build.rs" 2>/dev/null || true)
        vendor=$(git --git-dir="$db" rev-parse "${recorded_pin}:reverie-dbi/vendor/dynamorio" 2>/dev/null || true)
        third_party=$(git --git-dir="$db" rev-parse "${recorded_pin}:third-party" 2>/dev/null || true)

        if [[ -n $build_rs && -n $vendor && -n $third_party ]]; then
            if [[ $build_rs == "$REVERIE_DBI_CALIBRATED_BUILD_RS" &&
                $vendor == "$REVERIE_DBI_CALIBRATED_VENDOR_DYNAMORIO" &&
                $third_party == "$REVERIE_DBI_CALIBRATED_THIRD_PARTY" ]]; then
                echo recipe-inputs
                return 0
            fi
            # A genuine recipe change. Say which input moved, so the operator
            # knows whether to re-measure or to correct the record.
            {
                echo "reverie-dbi budget: DynamoRIO recipe changed at pin ${recorded_pin}; re-measure before carrying."
                [[ $build_rs != "$REVERIE_DBI_CALIBRATED_BUILD_RS" ]] &&
                    echo "  reverie-dbi/build.rs         ${REVERIE_DBI_CALIBRATED_BUILD_RS} -> ${build_rs}"
                [[ $vendor != "$REVERIE_DBI_CALIBRATED_VENDOR_DYNAMORIO" ]] &&
                    echo "  reverie-dbi/vendor/dynamorio ${REVERIE_DBI_CALIBRATED_VENDOR_DYNAMORIO} -> ${vendor}"
                [[ $third_party != "$REVERIE_DBI_CALIBRATED_THIRD_PARTY" ]] &&
                    echo "  third-party                  ${REVERIE_DBI_CALIBRATED_THIRD_PARTY} -> ${third_party}"
            } >&2
            return 1
        fi
    fi

    if [[ $recorded_pin == "$REVERIE_DBI_CALIBRATED_PIN" ]]; then
        echo recorded-pin-fallback
        return 0
    fi
    return 1
}
